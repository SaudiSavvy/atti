    {
      "id": "KSA-LL-004",
      "article": 4,
      "ar_heading": "المادة الرابعة :",
      "en_heading": "Article 4",
      "ar_sha256": "92fcfbdfe03b748e5126cc170cc3be095cb7fa909f8f147b71ae9130b2cd0639",
      "en_sha256": "1b36a01984f5639f2e9ae7a9d009af8b364d63bb8432e7e109f7c8107b4584d7",
      "ar_chars": 96,
      "en_chars": 109,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: employers and workers must adhere to Sharia when applying the Law."
      }
    },
    {
      "id": "KSA-LL-032",
      "article": 32,
      "ar_heading": "المادة الثانية والثلاثون :",
      "en_heading": "Article 32",
      "ar_sha256": "20d82960019ea0f7e60e3456d479202c8e5971a5d89232b268b0512a63de86e5",
      "en_sha256": "466748ed3eeffc3981f0b18d3c22ec595c60e76ddf40a4ccb520f0eaa70ebdb6",
      "ar_chars": 53,
      "en_chars": 107,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: recruitment from abroad for work requires Ministry approval."
      }
    },
    {
      "id": "KSA-LL-038",
      "article": 38,
      "ar_heading": "المادة الثامنة والثلاثون :",
      "en_heading": "Article 38",
      "ar_sha256": "2340ca79eaf20e6ca40f52c1610cc800a45f0cf1b2707d345e78469aa781c90a",
      "en_sha256": "f1b41996d5d40545580ef97ea84aff8d93f461be1ca436f910a9076931171da8",
      "ar_chars": 156,
      "en_chars": 237,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: no employment outside the profession on the work permit; worker may not change profession before legal procedures."
      }
    },
    {
      "id": "KSA-LL-059",
      "article": 59,
      "ar_heading": "المادة التاسعة والخمسون :",
      "en_heading": "Article 59",
      "ar_sha256": "af556aa47c348b5c237ed6d545be0150a3e49089fc0b1f8352c3896e40a6a14a",
      "en_sha256": "0afa053afd499ebb7a2f434f7c65ff9f9f74066208429021587412f1a41e712d",
      "ar_chars": 227,
      "en_chars": 283,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: monthly-paid worker may not be moved to daily/weekly/piecework/hourly pay without written consent; acquired rights preserved."
      }
    },
    {
      "id": "KSA-LL-065",
      "article": 65,
      "ar_heading": "المادة الخامسة والستون :",
      "en_heading": "Article 65",
      "ar_sha256": "1c8274277c9226fd701827e1fdc4632013f11cdd7279c68a1fec33079e0c6d97",
      "en_sha256": "82e8df33593d47a98093ce549834dfacaf6b0030d649f8b44fe1d7a9395c1f6a",
      "ar_chars": 993,
      "en_chars": 1302,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: worker duties beyond the Law - six numbered items (work per instructions; care of employer property; conduct; help in disasters without extra pay; medical examinations; confidentiality)."
      }
    },
    {
      "id": "KSA-LL-070",
      "article": 70,
      "ar_heading": "المادة السبعون :",
      "en_heading": "Article 70",
      "ar_sha256": "8e1cda7f8334aab4f70d2bec559c7d095526e7eb28e44004e52e0075bd455331",
      "en_sha256": "6b2fcab4d3804b6262d8a07092113d1c564838d719f11450b74bb415e0e21615",
      "ar_chars": 410,
      "en_chars": 529,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: no penalty for off-site acts unless work-related; fine per violation max five days' wage; one penalty per violation; deductions max five days' wage per month; unpaid suspension max five days per month."
      }
    },
    {
      "id": "KSA-LL-089",
      "article": 89,
      "ar_heading": "المادة التاسعة والثمانون :",
      "en_heading": "Article 89",
      "ar_sha256": "843c678594804e0d82c2912f16a60f87c4987e1258cdf0f5b4bc7879622612b0",
      "en_sha256": "1365ce3103ed9a4beaa0cbca74a5eeac4cd29bb9787ad98d40919638a03b3d28",
      "ar_chars": 72,
      "en_chars": 101,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: Council of Ministers may set a minimum wage on the Minister's proposal."
      }
    },
    {
      "id": "KSA-LL-092",
      "article": 92,
      "ar_heading": "المادة الثانية والتسعون :",
      "en_heading": "Article 92",
      "ar_sha256": "ad41bb1d3b6cb1704721a09220120c5e2d8cac94e64ba2fa1fac7fff48d007ea",
      "en_sha256": "b143ce45b718b6b7b5fd136ec6d7802dba8c75b4e4a133fe9800bb817c2aa58b",
      "ar_chars": 742,
      "en_chars": 928,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: no deductions without written consent except six numbered cases (10% loan cap; social insurance; savings fund; housing scheme; fines/damages; court judgment capped at one quarter), with alimony first."
      }
    },
    {
      "id": "KSA-LL-108",
      "article": 108,
      "ar_heading": "المادة الثامنة بعد المائة :",
      "en_heading": "Article 108",
      "ar_sha256": "8b95e72bb885b0811f0e13f88e9f760d16914850ca14fce536d8e5d75777433b",
      "en_sha256": "9382bf95e9415206cbbb567a610d9121234269774e25c463ff8278c060c870ec",
      "ar_chars": 520,
      "en_chars": 580,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: Articles 98 and 101 do not apply to four numbered cases (senior management; preparatory/supplementary work; intermittent work; guards and cleaners except civil security guards); Regulations set jobs and maximum hours for items 2-4."
      }
    },
    {
      "id": "KSA-LL-120",
      "article": 120,
      "ar_heading": "المادة العشرون بعد المائة :",
      "en_heading": "Article 120",
      "ar_sha256": "13cc327997813cb7dbfb82da0a3d7ffe2795c34c5c884edfed50cb3bca2256ad",
      "en_sha256": "4b66543bb00f57469fe3f41dfd97eced3baa9891f86d12546615785cbe6e158d",
