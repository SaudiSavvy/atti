      "en_chars": 380,
      "verification": {
        "ar_page_marks_amended": false,
        "en_appendix_references_article": false,
        "content_review": "Both: Minister issues rules for part-time work; the Law applies only as the Minister decides, except occupational safety/health and work-injury protection."
      }
